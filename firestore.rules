rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staff() {
      return signedIn()
        && 'role' in request.auth.token
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'social_worker');
    }
    function anonymousApplicant() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validStatus(value) { return value in ['draft', 'open', 'closed', 'archived']; }
    function validSubmissionStatus(value) { return value in ['submitted', 'reviewed', 'excluded']; }
    function validAuditAction(value) {
      return value in ['form_created', 'draft_saved', 'form_published', 'status_changed', 'round_started', 'submission_updated', 'images_cleaned'];
    }

    match /eventForms/{formId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validStatus(request.resource.data.status);
      allow update: if staff()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.publicToken == resource.data.publicToken
        && request.resource.data.tokenHash == resource.data.tokenHash
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && validStatus(request.resource.data.status);
      allow delete: if false;
    }

    match /eventFormVersions/{versionId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.id == versionId
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 100;
      allow update, delete: if false;
    }

    match /eventFormRounds/{roundId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.id == roundId
        && validStatus(request.resource.data.status);
      allow update: if staff()
        && request.resource.data.id == resource.data.id
        && request.resource.data.formId == resource.data.formId
        && validStatus(request.resource.data.status);
      allow delete: if false;
    }

    match /eventFormPublic/{tokenHash} {
      allow get: if anonymousApplicant();
      allow list: if false;
      allow create, update: if staff()
        && request.resource.data.keys().hasOnly([
          'formId', 'title', 'description', 'eventDateTime', 'location', 'poster',
          'activeRoundId', 'activeVersionId', 'fields', 'fieldIds', 'publicAssetIds',
          'publicImageBytes',
          'applicationStartAt', 'applicationEndAt', 'status', 'completionMessage',
          'duplicatePolicy', 'duplicateFieldId', 'updatedAt', 'schemaVersion', 'tokenHashVersion'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.tokenHashVersion == 'sha256'
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 100
        && request.resource.data.publicAssetIds is list
        && request.resource.data.publicAssetIds.size() <= 12
        && request.resource.data.publicImageBytes is int
        && request.resource.data.publicImageBytes >= 0
        && request.resource.data.publicImageBytes <= 2 * 1024 * 1024
        && validStatus(request.resource.data.status);
      allow delete: if false;
    }

    match /eventFormSubmissions/{submissionId} {
      function publicForm() {
        return get(/databases/$(database)/documents/eventFormPublic/$(request.resource.data.tokenHash)).data;
      }
      function inApplicationWindow(publicData) {
        return (publicData.applicationStartAt == null || request.time >= publicData.applicationStartAt)
          && (publicData.applicationEndAt == null || request.time <= publicData.applicationEndAt);
      }
      allow create: if anonymousApplicant()
        && request.resource.data.keys().hasOnly(['formId', 'roundId', 'versionId', 'tokenHash', 'submitterUid', 'answersBase64', 'answerIds', 'status', 'submittedAt'])
        && request.resource.data.formId is string
        && request.resource.data.formId.size() <= 128
        && request.resource.data.roundId is string
        && request.resource.data.roundId.size() <= 128
        && request.resource.data.versionId is string
        && request.resource.data.versionId.size() <= 128
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && request.resource.data.submitterUid is string
        && request.resource.data.submitterUid.size() <= 128
        && request.resource.data.submitterUid == request.auth.uid
        && submissionId == request.resource.data.roundId + '__' + request.auth.uid
        && request.resource.data.submittedAt == request.time
        && request.resource.data.status == 'submitted'
        && request.resource.data.answersBase64 is string
        && request.resource.data.answersBase64.size() > 0
        && request.resource.data.answersBase64.size() <= 68268
        && request.resource.data.answerIds is list
        && request.resource.data.answerIds.size() <= 100
        && request.resource.data.answerIds.toSet().size() == request.resource.data.answerIds.size()
        && request.resource.data.answerIds.hasOnly(publicForm().fieldIds)
        && publicForm().formId == request.resource.data.formId
        && publicForm().status == 'open'
        && publicForm().activeRoundId == request.resource.data.roundId
        && publicForm().activeVersionId == request.resource.data.versionId
        && inApplicationWindow(publicForm());
      allow read, list: if staff();
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminMemo', 'submissionUpdatedBy', 'submissionUpdatedAt'])
        && validSubmissionStatus(request.resource.data.status)
        && request.resource.data.submissionUpdatedBy == request.auth.uid
        && request.resource.data.submissionUpdatedAt == request.time
        && request.resource.data.get('adminMemo', '') is string
        && request.resource.data.get('adminMemo', '').size() <= 5000;
      allow delete: if false;
    }

    match /eventFormImageBlobs/{assetId} {
      function validImage() {
        return request.resource.data.assetId == assetId
          && request.resource.data.formId is string
          && request.resource.data.contentType == 'image/webp'
          && request.resource.data.dataBase64 is string
          && request.resource.data.dataBase64.size() <= 250 * 1024
          && request.resource.data.encodedBytes == request.resource.data.dataBase64.size()
          && request.resource.data.state in ['temp', 'active', 'archived', 'unused']
          && request.resource.data.alt is string
          && request.resource.data.alt.size() <= 500;
      }
      function publicImage() {
        return resource.data.state == 'active'
          && resource.data.publicTokenHash is string
          && exists(/databases/$(database)/documents/eventFormPublic/$(resource.data.publicTokenHash))
          && get(/databases/$(database)/documents/eventFormPublic/$(resource.data.publicTokenHash)).data.status == 'open'
          && assetId in get(/databases/$(database)/documents/eventFormPublic/$(resource.data.publicTokenHash)).data.publicAssetIds;
      }
      allow get: if staff() || (anonymousApplicant() && publicImage());
      allow list: if staff();
      allow create: if staff() && validImage()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if staff() && validImage()
        && request.resource.data.formId == resource.data.formId
        && request.resource.data.assetId == resource.data.assetId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if staff() && resource.data.state in ['temp', 'unused'];
    }

    match /eventFormAuditLogs/{auditId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && validAuditAction(request.resource.data.action)
        && request.resource.data.keys().hasOnly(['formId', 'actorUid', 'action', 'details', 'at']);
      allow update, delete: if false;
    }

    // Blaze 전용 기존 컬렉션은 Spark 운영 클라이언트에서 사용하지 않는다.
    match /eventFormPublicTokens/{id} { allow read, write: if false; }
    match /eventFormDuplicateKeys/{id} { allow read, write: if false; }
    match /eventFormRateLimits/{id} { allow read, write: if false; }
    match /eventFormAssets/{id} { allow read, write: if false; }

    // 기존 앱 컬렉션은 승인된 관리자·전담사회복지사 계정만 접근한다.
    match /{collectionName}/{document=**} {
      allow read, write: if staff()
        && collectionName != 'eventForms'
        && collectionName != 'eventFormVersions'
        && collectionName != 'eventFormRounds'
        && collectionName != 'eventFormSubmissions'
        && collectionName != 'eventFormPublic'
        && collectionName != 'eventFormPublicTokens'
        && collectionName != 'eventFormDuplicateKeys'
        && collectionName != 'eventFormRateLimits'
        && collectionName != 'eventFormAssets'
        && collectionName != 'eventFormImageBlobs'
        && collectionName != 'eventFormAuditLogs';
    }
  }
}
