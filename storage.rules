rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function staff() {
      return signedIn()
        && 'role' in request.auth.token
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'social_worker');
    }
    function safeImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function tempMetadataMatches(formId, assetId) {
      return request.resource.metadata.formId == formId
        && request.resource.metadata.assetId == assetId;
    }

    function activeImageIsPublic(formId) {
      return resource.metadata.formId == formId
        && resource.metadata.assetId != null
        && firestore.exists(/databases/(default)/documents/eventForms/$(formId))
        && firestore.get(/databases/(default)/documents/eventForms/$(formId)).data.status == "open"
        && firestore.exists(/databases/(default)/documents/eventFormAssets/$(resource.metadata.assetId))
        && firestore.get(/databases/(default)/documents/eventFormAssets/$(resource.metadata.assetId)).data.formId == formId
        && firestore.get(/databases/(default)/documents/eventFormAssets/$(resource.metadata.assetId)).data.state == "active";
    }

    match /eventFormAssets/{formId}/temp/{uid}/{assetId}/{fileName} {
      allow read: if staff() && request.auth.uid == uid;
      allow create, update: if staff() && request.auth.uid == uid
        && safeImage() && tempMetadataMatches(formId, assetId);
      allow delete: if staff() && request.auth.uid == uid;
    }
    match /eventFormAssets/{formId}/active/{allPaths=**} {
      allow read: if staff() || activeImageIsPublic(formId);
      allow write: if false;
    }
    match /eventFormAssets/{formId}/archived/{allPaths=**} {
      allow read: if staff();
      allow write: if false;
    }
    match /eventFormAssets/{formId}/unused/{allPaths=**} {
      allow read, write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
